# Copy this file to .env.local and fill in what you have.
# Anything left blank runs in demo mode: forms work, but nothing is charged, saved or sent.
# Never commit real keys. On Vercel, add these under Project Settings > Environment Variables.

# Public address of the site (used for Stripe return links)
SITE_URL=http://localhost:5173

# Stripe: donations (one-time and monthly) and ticket sales
STRIPE_SECRET_KEY=

# Mailchimp: newsletter sign-ups (and volunteers who opt in)
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=

# Resend: emails volunteer applications and free-event registrations to your team
RESEND_API_KEY=
FROM_EMAIL=
TEAM_INBOX=
